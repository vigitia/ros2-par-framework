# Written by Claude Code
# RViz view of the PAR setup with an Intel RealSense (par.launch.py with camera realsense): world grid, TF frames,
# the RealSense's colour frustum (drawn by the CameraInfo display from /camera/camera_info) and its live image.
# Copy of par_framework_kinect.rviz without the point cloud, which the driver only publishes with
# pointcloud.enable; Best Effort also receives from the driver's Reliable publishers.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Names: true
    - Class: rviz_default_plugins/CameraInfo
      Enabled: true
      Name: RealSense frustum
      # Length of the frustum in metres along the optical axis. Longer than any expected camera height, so
      # it passes through the table even when the camera is tilted; RViz cannot clip it at the table plane
      Far clip: 2
      # Edges only, opaque: Alpha applies to edges and polygons alike, and half-transparent shapes are sorted
      # by distance instead of depth-tested, otherwise the far rectangle and the grid hide the lines from some angles
      Show polygons: false
      Alpha: 1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera_info
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RealSense image
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
    # Projection area selected with surface_selector, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Projection area
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /projection_corners/markers
    # Projector image on the table from the calibrated mapping (projection_calibrator); should
    # coincide with the clicked projection area
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Projector (calibrated)
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /projection_mapping/markers
    # Objects from the object detector, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Objects
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /objects/markers
    # Hands from hand_landmarks, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Hands
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /hand_landmarks/markers
    # Fiducial markers from fiducials_detector, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Fiducials
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fiducials/markers
    # Pages from page_locator, projected on the table
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Pages
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pages/markers
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
# Docks Displays on the left, Views and the RealSense image on the right, as in par_framework_kinect.rviz.
# QMainWindow State is Qt's saved dock layout; it names the image panel, so it must match the Image display's
# Name. Arrange the panels in RViz and save the config (Ctrl+S) to change it. No window position on purpose, see
# par_framework_kinect.rviz: remove X and Y again after saving.
Window Geometry:
  Width: 1920
  Height: 1080
  Displays:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  RealSense image:
    collapsed: false
  QMainWindow State: 
  Views:
    collapsed: false
