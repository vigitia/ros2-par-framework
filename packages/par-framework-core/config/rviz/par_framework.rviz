# Written with the help of Claude Code
# Configuration for the RViz2 tool.
#
# RViz view of the current PAR setup.
# It takes care of displaying:
# - world grid
# - TF frames
# - the main camera's live image
# - the markers of every started camera's rviz_bridge: camera frustums and the output of all published custom
#   messages of the PAR framework (fiducials, objects, hand landmarks, etc.). par.launch.py remaps every
#   bridge onto the same marker topics; each display's Namespaces list the cameras (e.g. kinect/outline)
#
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Names: true
    # Written with the help of Claude Code: the camera's field of view down to the surface, drawn by rviz_bridge;
    # RViz's CameraInfo display loses its edges from some viewing angles
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Camera frustum
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera_frustum/markers
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera image
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
    # Coloured depth point cloud from e.g. the Kinect driver, in depth_camera_link.
    - Class: rviz_default_plugins/PointCloud2
      # Off while point_cloud is off in par_setup.yaml
      Enabled: false
      Name: Depth point cloud
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 0
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /points2
    # Projection area selected with projection_corner_selector, projected onto the surface by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Projection area
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /projection_corners/markers
    # Projector image on the surface from the calibrated mapping (projection_calibrator)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Projector (calibrated)
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /projection_mapping/markers
    # Objects from the object detector, projected onto the surface by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Objects
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /objects/markers
    # Hands from hand_landmarks, projected onto the surface by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Hands
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /hand_landmarks/markers
    # Fiducial markers from fiducials_detector, projected onto the surface by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Fiducials
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fiducials/markers
    # Pages from page_locator, projected on the surface
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Pages
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pages/markers
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
# Docks Displays on the left, Views and the camera image on the right, so all three are visible on
# every start. QMainWindow State is Qt's saved dock layout, generated with Qt; it names the image
# panel, so it must match the Image display's Name. Arrange the panels in RViz and save the config
# (Ctrl+S) to change it. No window position on purpose: GNOME then opens
# RViz on the current monitor (the one being worked on), and with a monitor-sized window its
# auto-maximize setting maximises it there. Saving adds X and Y: remove them again, or RViz always
# opens at that spot (possibly on the projector).
Window Geometry:
  Width: 1920
  Height: 1080
  Displays:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  Camera image:
    collapsed: false
  # Hex of Qt's QMainWindow::saveState(): panel names (UTF-16), their dock area, order and size in
  # logical pixels, plus the 3D view's size. No screen positions, so it works on any machine; Qt
  # shrinks it to fit a smaller window and ignores it if a panel name no longer matches.
  QMainWindow State: 
  Views:
    collapsed: false
