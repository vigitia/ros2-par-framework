# Written by Claude Code
# RViz view of the PAR setup, for every camera (par.launch.py with rviz): world grid, TF frames, the camera's
# frustum (drawn by the CameraInfo display from /camera/camera_info), its live image and what rviz_bridge projects
# onto the table. One file serves all cameras, because every driver is remapped onto the same /camera/... topics.
# What only some cameras or sensors publish is in here too, switched off; a disabled display subscribes to
# nothing. The camera topics are subscribed Best Effort: that also receives from drivers that publish Reliable,
# while RViz's default Reliable would receive nothing from a Best Effort driver.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Names: true
    - Class: rviz_default_plugins/CameraInfo
      Enabled: true
      Name: Camera frustum
      # Length of the frustum in metres along the optical axis. Longer than any expected camera height, so
      # it passes through the table even when the camera is tilted; RViz cannot clip it at the table plane
      Far clip: 2
      # Edges only, opaque: Alpha applies to edges and polygons alike, and half-transparent shapes are sorted
      # by distance instead of depth-tested, otherwise the far rectangle and the grid hide the lines from some angles
      Show polygons: false
      Alpha: 1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera_info
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera image
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
    # Events of the event camera (par_launch event_camera), collected into images by its renderer. Off by
    # default: most setups have no event camera
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Event camera image
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /event_camera/renderer/image_raw
    # Coloured depth point cloud from the Kinect driver, in depth_camera_link. Not remapped, since no framework
    # node reads it, so only the Kinect fills this topic
    - Class: rviz_default_plugins/PointCloud2
      # Off while point_cloud is off in par_setup.yaml
      Enabled: false
      Name: Kinect point cloud
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 0
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /points2
    # Projection area selected with surface_selector, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Projection area
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /projection_corners/markers
    # Projector image on the table from the calibrated mapping (projection_calibrator); should
    # coincide with the clicked projection area
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Projector (calibrated)
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /projection_mapping/markers
    # Objects from the object detector, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Objects
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /objects/markers
    # Hands from hand_landmarks, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Hands
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /hand_landmarks/markers
    # Fiducial markers from fiducials_detector, projected onto the table by rviz_bridge
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Fiducials
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fiducials/markers
    # Pages from page_locator, projected on the table (written by Claude Code)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Pages
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pages/markers
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
# Docks Displays on the left, Views and the camera image on the right, so all three are visible on
# every start. QMainWindow State is Qt's saved dock layout, generated with Qt; it names the image
# panel, so it must match the Image display's Name. Arrange the panels in RViz and save the config
# (Ctrl+S) to change it. No window position on purpose: GNOME then opens
# RViz on the current monitor (the one being worked on), and with a monitor-sized window its
# auto-maximize setting maximises it there. Saving adds X and Y: remove them again, or RViz always
# opens at that spot (possibly on the projector).
Window Geometry:
  Width: 1920
  Height: 1080
  Displays:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  Camera image:
    collapsed: false
  QMainWindow State: 
  Views:
    collapsed: false
