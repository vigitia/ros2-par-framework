# Written by Claude Code
# Camera type entry in the ament index (resource type par_framework_cameras); format:
# templates/par_camera/ of ros2-par-framework. The file name is the camera type.
display_name: Event camera
description: Event camera through metavision_driver; its events collected into images.
package: par_framework_core
launch_file: camera_event.launch.py
# The released driver this launch file starts, installed separately (config/ros_packages.list)
required_packages: [metavision_driver, event_camera_renderer]
body_frame: link
streams: [image_raw, events]
intrinsics: none
# The driver's serial is a parameter in the parameter files, not passed by the launch file yet
serial: none
