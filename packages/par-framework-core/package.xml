<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Co-authored by Claude Code: the dependencies, without the optional calibration packages -->
<package format="3">
  <name>par_framework_core</name>
  <version>0.1.0</version>
  <description>Launch files and per-setup parameters that compose the PAR framework nodes into a running system.</description>
  <maintainer email="vitus.maierhoefer@gmail.com">vitus</maintainer>
  <license>MIT</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>

  <exec_depend>rviz_bridge</exec_depend>
  <exec_depend>fiducials_detector</exec_depend>
  <exec_depend>object_detector</exec_depend>
  <exec_depend>hand_landmarks</exec_depend>
  <!-- Calibration is optional: surface_selector, projection_calibration_server and
       camera_pose_calibrator (ros2-par-framework-calibration) are not declared. par.launch.py
       starts the server only when it is installed; the calibration launch files need the repo. -->

  <exec_depend>v4l2_camera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
