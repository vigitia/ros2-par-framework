<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Co-authored by Claude Code: the dependencies, without the optional calibration packages, sensor
     processing nodes and camera drivers -->
<package format="3">
  <name>par_framework_core</name>
  <version>0.1.0</version>
  <description>Launch files and per-setup parameters that compose the PAR framework nodes into a running system.</description>
  <maintainer email="vitus.maierhoefer@gmail.com">vitus</maintainer>
  <license>MIT</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <!-- Lens calibration: scripts/run_cameracalibrator.sh and the setup wizard's backend -->
  <exec_depend>camera_calibration</exec_depend>

  <exec_depend>rviz_bridge</exec_depend>
  <!-- Calibration is optional: projection_calibration, projection_calibration_server and
       camera_pose_calibrator (ros2-par-framework-calibration) are not declared. par.launch.py
       starts the server only when it is installed; the calibration launch files need the repo. -->
  <!-- Sensor processing nodes are optional too: par.launch.py starts the ones registered in the
       ament index (par_framework_sensor_nodes). Not declared, so rosdep never tries to resolve them
       as released packages on an installation without them. -->
  <!-- Camera drivers are optional too: each installation chooses them (config/installed_ros_packages.list
       for released ones, config/installed_repos.list for drivers from source). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
