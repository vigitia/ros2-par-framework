# Written by Claude Code
# Camera type entry in the ament index (resource type par_framework_cameras); format:
# README.md of par_framework_core. The file name is the camera type.
display_name: Webcam
description: Any UVC camera through v4l2_camera.
package: par_camera_adapters
launch_file: camera_webcam.launch.py
# Driver defaults the framework needs, loaded before par_setup.yaml and the profile
parameters_file: config/webcam.yaml
# The released driver this launch file starts, installed separately (config/installed_ros_packages.list)
required_packages: [v4l2_camera]
body_frame: link
streams: [image_raw, camera_info, set_camera_info]
intrinsics: calibratable
# v4l2_camera opens a device path, not a serial: one webcam per setup
serial: none
