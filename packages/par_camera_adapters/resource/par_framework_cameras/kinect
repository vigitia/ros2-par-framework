# Written by Claude Code
# Camera type entry in the ament index (resource type par_framework_cameras); format:
# templates/par_camera/ of ros2-par-framework. The file name is the camera type.
display_name: Azure Kinect
description: Depth camera through azure_kinect_ros_driver, with its factory calibration.
package: par_camera_adapters
launch_file: camera_kinect.launch.py
# Driver defaults the framework needs, loaded before par_setup.yaml and the profile
parameters_file: config/kinect.yaml
# The driver's own body frame, x forward and z up
# The released driver this launch file starts, installed separately (config/required_ros_packages.list)
required_packages: [azure_kinect_ros_driver]
body_frame: camera_base
streams: [image_raw, camera_info, depth_registered/image_raw, ir/image_raw,
          depth_sensor/ir/image_raw, depth_sensor/depth/image_raw, depth_sensor/camera_info]
intrinsics: factory
# The launch file passes it as sensor_sn. The connected units are the Kinects' depth camera USB
# devices (Microsoft 045e, product 097c); each Kinect has several USB devices with the same serial,
# which is the one the driver takes
serial: listed
usb_vendor_id: '045e'
usb_product_id: '097c'
