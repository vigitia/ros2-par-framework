# Written by Claude Code
# Camera type entry in the ament index (resource type par_framework_cameras); format:
# templates/par_camera/ of ros2-par-framework. The file name is the camera type.
display_name: FLIR Blackfly S
description: Machine vision camera through spinnaker_camera_driver, monochrome or colour.
package: par_camera_adapters
launch_file: camera_blackfly.launch.py
# The released driver this launch file starts, installed separately (config/required_ros_packages.list)
required_packages: [spinnaker_camera_driver]
body_frame: link
streams: [image_raw, camera_info, set_camera_info]
intrinsics: calibratable
# The connected units are the USB devices of FLIR (1e10); they report the serial in hexadecimal,
# the driver and the label on the camera use the decimal number. A GigE unit is not a USB device
# and is not listed, its serial is typed
serial: listed
usb_vendor_id: '1e10'
usb_serial_base: 16
