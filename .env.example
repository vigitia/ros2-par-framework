# Copied to .env by setup.sh, which fills in the display-related values for the
# machine it runs on. Edit .env (not this file) to tweak your local setup.

# ROS 2 distribution -- must match an osrf/ros:<distro>-desktop image tag.
ROS_DISTRO=lyrical

# DDS domain. Machines on the same LAN only see each other's nodes when this
# matches; bump it if you share a network with another ROS 2 setup.
ROS_DOMAIN_ID=0

CONTAINER_NAME=par_framework

# X11 forwarding for RViz / rqt / the fullscreen projector window.
DISPLAY=:0
XAUTHORITY=
