# Written by Claude Code
# The camera type's entry in the ament index (resource type par_framework_cameras). The file name is
# the camera type (lower case, letters, digits and _), the name profiles and camera:= use.
# par.launch.py and the setup wizard read it through ament_index_python; the format is checked by
# par_framework_core.camera_types.read_camera_entry (see README.md).

# Shown in the setup wizard
display_name: Example camera
description: One sentence on the camera and its driver.

# The package that installs launch_file, and the file in its share/<package>/launch/
package: example_camera
launch_file: example_camera.launch.py

# Optional: ROS packages launch_file starts besides package, e.g. a released driver when the entry
# lives in another package; the camera type counts as installed when all of them are (default [])
required_packages: []

# Optional: the type's default parameter file, relative to share/<package>/ (e.g.
# config/example_camera.yaml, installed through setup.py data_files). Loaded before par_setup.yaml
# and the profile, so both override it. For a third-party driver whose defaults do not suit the
# framework (e.g. its colour order); a driver written for the framework sets them in its code
# parameters_file: config/example_camera.yaml

# The camera's body frame without the camera name: the framework's mount transform goes
# world -> <camera name>_<body_frame>. link for a driver that publishes <camera name>_link
body_frame: link

# The streams the launch file offers below the camera's namespace, from the framework's list
# (camera_types.CAMERA_STREAM_NAMES): image_raw, image_raw/compressed, camera_info,
# set_camera_info, depth_registered/image_raw, ir/image_raw, depth_sensor/ir/image_raw,
# depth_sensor/depth/image_raw, depth_sensor/camera_info, events
streams: [image_raw, camera_info, set_camera_info]

# Where the intrinsics come from: calibratable (a file per unit, written through set_camera_info by
# scripts/run_cameracalibrator.sh and passed as camera_info_url), factory (the driver publishes its
# own) or none (no camera_info)
intrinsics: calibratable

# Optional: how units of this type are told apart (default none). none: one unit per setup, the
# launch file ignores serial; typed: the launch file passes serial to the driver, the user types
# it; listed: as typed, and the setup wizard lists the connected units' serials through one of:
#   v4l_by_id_prefix: the names /dev/v4l/by-id/<prefix>_<serial>-video-index0 (UVC cameras), or
#   usb_vendor_id: the USB devices of this vendor id (4 hexadecimal digits as text, as lsusb shows
#   it), plus usb_serial_base: 16 when they report in hexadecimal what the driver takes in decimal
serial: none
