# Node repositories are automatically cloned to the src/ folder and should not be commited to the core framework
/src/

# Dependency manifests staged for the image build (generated).
/docker/deps/

# Machine-local configuration.
/.env

# Calibration of this physical setup, written by nodes: the projection corners (projection_corners_node, from
# surface_selector), the table-to-projector mapping (projection_mapping_node, from projection_calibrator) and the
# measured camera pose (camera_pose_calibrator).
/packages/par-framework-core/config/projection_corners.yaml
/packages/par-framework-core/config/projection_mapping_*.yaml
/packages/par-framework-core/config/camera_pose_*.yaml

# colcon output. These folders will be created when the nodes in src/ are built locally, outside the Docker container
/build/
/install/
/log/

# Python venv for testing nodes locally outside Docker.
/.venv/

# Models used for e.g. the object detector node
/models/

__pycache__/
*.py[cod]

.idea/