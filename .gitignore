# Co-authored by Claude Code (named profiles folder).
# Node repositories are automatically cloned to the src/ folder and should not be commited to the core framework
/src/

# Dependency manifests staged for the image build (generated).
/docker/deps/

# Machine-local configuration. config/profiles/ holds the setup wizard's named profiles; par_setup.yaml, the
# default profile, stays tracked.
/.env
/packages/par-framework-core/config/profiles/

# Calibration of this physical setup, written by nodes: the projection corners (from surface_selector) and the
# table-to-projector mapping (from projection_calibrator), both by projection_calibration_server_node, the
# measured camera pose (camera_pose_calibrator) in calibration/extrinsics/, and the camera intrinsics
# (cameracalibrator) in calibration/intrinsics/.
/packages/par-framework-core/config/calibration/

# colcon output. These folders will be created when the nodes in src/ are built locally, outside the Docker container
/build/
/install/
/log/

# Python venv for testing nodes locally outside Docker.
/.venv/

# Models used for e.g. the object detector node
/models/

__pycache__/
*.py[cod]
.pytest_cache/

.idea/