
# Calibration files belonging to a local setup
/packages/par-framework-core/config/calibration/

# Profiles (profile:=<name>) belonging to local setups
/packages/par-framework-core/config/profiles/

# config/catalog_repos.list lists available components for the framework.
# What is actually installed or added manually by the user is stored in these files:
/config/installed_repos.list
/config/installed_ros_packages.list
/config/user_catalog_repos.list


# Node repositories are cloned to the src/ folder and should not be commited
/src/
# colcon output, created when the workspace is built
/build/
/install/
/log/

# Python venv for the PyPI dependencies
/.venv/

# Models like YOLO, SAM, etc. Used for e.g. the object detector node
/models/

# Captured frames, datasets and training runs, e.g. of object teaching
/datasets/

__pycache__/
*.py[cod]
.pytest_cache/

.idea/

# Checkerboard image for intrinsic camera calibration. Users create their own in their desired size
utils/checkerboard.png