# Nodes that make up the current ROS2 PAR Framework.
# Co-authored by Claude Code
#
# One node repository per line:
# <directory>   <git-url>   [branch]
#
# <directory>  name of the checkout under src/ (use the ROS package name for consistency)
# <git-url>    cloned by scripts/sync_nodes.sh over SSH -- needs a GitHub key
#              in your ssh-agent (setup.sh checks this for you)
# [branch]     optional; "-" or omitted means the remote's default branch
#
# Every node listed here will be cloned and installed automatically on setup, including
# its package.xml + requirements.txt dependencies. From then on, the node will be available for
# you to use, but you still decide what you need depending on your launch configuration.


# Framework Core:

custom_interfaces         git@github.com:vigitia/ros2-par-framework-interfaces.git          main


# Calibration:

framework-calibration     git@github.com:vigitia/ros2-par-framework-calibration.git         main


# Sensors:

logitech_brio             git@github.com:vigitia/ros2-logitech-brio.git                     main
azure_kinect_ros_driver   git@github.com:nlouman/azure_kinect_ros_driver_extended.git       main
realsense2_camera         git@github.com:realsenseai/realsense-ros.git                      ros2-master


# Sensor Processing Nodes:

object_detector           git@github.com:vigitia/ros2-par-framework-object-detection.git    main
fiducials_detector        git@github.com:vigitia/ros2-par-framework-fiducials.git           main
hand_landmarks            git@github.com:vigitia/ros2-par-framework-hand-landmarks.git      main
gesture_detector          git@github.com:vigitia/ros2-par-framework-gestures.git            main
page_locator              git@github.com:vigitia/ros2-par-framework-page-locator.git        main


# Applications: