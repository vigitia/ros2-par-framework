# Written with the help of Claude Code

# Optional repositories containing ROS2 nodes that can be added to an installation of the PAR framework:
# Cameras, sensor processing nodes and apps.
#
# Same format as config/required_repos.list (<directory> <git-url> [branch]).
# The repositories every installation needs are listed there, not here.
#

# IMPORTANT NOTE: At the moment, some of these repos listed here might not yet be available
# publicly. Feel free to contact me (Vitus) if you want early access.

# Sensors (released camera drivers are rosdep keys in config/installed_ros_packages.list instead):

logitech_brio             git@github.com:vigitia/ros2-logitech-brio.git                     main
see3cam_cu40              git@github.com:vigitia/ros2-see3cam-cu40.git                      main
azure_kinect_ros_driver   git@github.com:nlouman/azure_kinect_ros_driver_extended.git       main


# Sensor processing nodes:

object_detector           git@github.com:vigitia/ros2-par-framework-object-detection.git    main
hand_landmarks            git@github.com:vigitia/ros2-par-framework-hand-landmarks.git      main
gesture_detector          git@github.com:vigitia/ros2-par-framework-gestures.git            main
page_locator              git@github.com:vigitia/ros2-par-framework-page-locator.git        main
projection_mask           git@github.com:vigitia/ros2-par-framework-projection-mask.git     main
object_teaching           git@github.com:vigitia/ros2-par-framework-object-teaching.git     main


# Applications:

# The rendering manager is a special case. It acts as an app of the framework,
# but its purpose is to start one or multiple apps itself and positions them on the interactive surface
rendering_manager         git@github.com:vigitia/ros2-par-framework-rendering-manager.git   main
demo_app                  git@github.com:vigitia/ros2-par-framework-demo-application.git    main
worksheets_app            git@github.com:vigitia/ros2-par-framework-worksheets.git          main
