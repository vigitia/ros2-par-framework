# Written with the help of Claude Code

# ROS2 node repositories every installation of the PAR framework needs.
# These nodes live in their own repository for better modularity and reusability.
#
# One node repository per line:
# <directory>   <git-url>   [branch]
#
# <directory>  name of the checkout under src/ (use the ROS package name for consistency)
# <git-url>    scripts/sync_nodes.sh will take the URL and do the work
# [branch]     optional; "-" or omitted means the remote's default branch
#
# Every node listed here is cloned and installed by scripts/local_build.sh, including its
# package.xml and requirements.txt dependencies.


# Shared ROS 2 message, service and action definitions for the framework
par_framework_interfaces  git@github.com:vigitia/ros2-par-framework-interfaces.git          main


# Calibration (everything related to intrinsic and extrinsic calibration, cameras and projectors).
# fiducials_detector finds the projected markers used in some calibration steps:
framework-calibration     git@github.com:vigitia/ros2-par-framework-calibration.git         main
fiducials_detector        git@github.com:vigitia/ros2-par-framework-fiducials.git           main
